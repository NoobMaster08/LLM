from pathlib import Path
import io
import re

import fitz
import pytesseract
from PIL import Image
from pypdf import PdfReader, PdfWriter
from pytesseract import Output


INPUT_FOLDER = Path("input")
OUTPUT_FOLDER = Path("output")

INPUT_FOLDER.mkdir(exist_ok=True)
OUTPUT_FOLDER.mkdir(exist_ok=True)


# ============================================================
# ОЦЕНКА КАЧЕСТВА РАСПОЗНАВАНИЯ
# ============================================================

def get_score(image):

    data = pytesseract.image_to_data(
        image,
        lang="rus",
        output_type=Output.DICT,
        config="--psm 6"
    )

    confidences = []
    word_count = 0

    for text, conf in zip(data["text"], data["conf"]):

        text = text.strip()

        try:
            conf = float(conf)
        except:
            continue

        if text and conf > 0:
            confidences.append(conf)

            # Учитываем распознанные слова
            if re.search(r"[А-Яа-яЁё]{2,}", text):
                word_count += 1

    if not confidences:
        return 0

    avg_confidence = sum(confidences) / len(confidences)

    # Итоговая оценка:
    # confidence + небольшой бонус за количество русских слов
    score = avg_confidence + word_count * 0.2

    return score


# ============================================================
# ОПРЕДЕЛЕНИЕ НАПРАВЛЕНИЯ ПОВОРОТА
# ============================================================

def determine_rotation(image):

    # 90 градусов вправо
    right_image = image.rotate(-90, expand=True)

    # 90 градусов влево
    left_image = image.rotate(90, expand=True)

    right_score = get_score(right_image)
    left_score = get_score(left_image)

    print(
        f"    вправо: {right_score:.2f}, "
        f"влево: {left_score:.2f}"
    )

    if right_score >= left_score:
        return 90
    else:
        return 270


# ============================================================
# ОПРЕДЕЛЯЕМ ПОСЛЕДНИЙ НОМЕР В OUTPUT
# ============================================================

numbers = []

for file in OUTPUT_FOLDER.glob("page_*.pdf"):

    match = re.match(r"page_(\d+)\.pdf$", file.name)

    if match:
        numbers.append(int(match.group(1)))


page_number = max(numbers, default=0) + 1


# ============================================================
# ОБРАБОТКА PDF
# ============================================================

pdf_files = sorted(INPUT_FOLDER.glob("*.pdf"))

print(f"Найдено PDF: {len(pdf_files)}")


for pdf_file in pdf_files:

    print(f"\nОбработка: {pdf_file.name}")

    reader = PdfReader(pdf_file)
    doc = fitz.open(pdf_file)

    for i, page in enumerate(reader.pages):

        print(f"  Страница {i + 1}")

        # Рендерим страницу в изображение
        pix = doc[i].get_pixmap(
            matrix=fitz.Matrix(2, 2),
            alpha=False
        )

        image = Image.open(
            io.BytesIO(pix.tobytes("png"))
        )

        # Определяем направление поворота
        try:
            rotation = determine_rotation(image)

        except Exception as e:
            print(f"    Ошибка определения ориентации: {e}")
            rotation = 90

        # Поворачиваем PDF-страницу
        page.rotate(rotation)

        writer = PdfWriter()
        writer.add_page(page)

        output_file = (
            OUTPUT_FOLDER /
            f"page_{page_number:04d}.pdf"
        )

        with open(output_file, "wb") as f:
            writer.write(f)

        direction = (
            "вправо"
            if rotation == 90
            else "влево"
        )

        print(
            f"    сохранено: {output_file.name} "
            f"({direction})"
        )

        page_number += 1

    doc.close()


print("\nГотово.")
